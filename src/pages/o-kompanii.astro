---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import AboutService from '@/components/AboutService.astro';
import Benefits from '@/components/Benefits.astro';
import Steps from '@/components/Steps.astro';
import BrandStrip from '@/components/BrandStrip.astro';
import ServiceGrid from '@/components/ServiceGrid.astro';
import Districts from '@/components/Districts.astro';
import LeadForm from '@/components/LeadForm.astro';

import { APPLIANCES } from '@/data/appliances';
import { plural } from '@/lib/format';
import { CITY } from '@/lib/city';
import { BRAND, WARRANTY } from '@/config/site';
import { HOME_COPY } from '@/data/copy';
import { absoluteUrl, buildTitle } from '@/lib/seo';
import { breadcrumbs } from '@/lib/schema';

const copy = HOME_COPY[CITY.slug];

const h1 = `О сервисе ${BRAND.name} ${CITY.inPrep}`;

const title = buildTitle(`О сервисе`, `выездной ремонт техники ${CITY.inPrep}`);
const description =
  `${BRAND.name} — выездной ремонт крупной бытовой техники ${CITY.inPrep}. ` +
  `Как мы работаем, почему не берём предоплату и что входит в гарантию до ${WARRANTY.workMonths} месяцев.`;

const faultCount = APPLIANCES.reduce((n, a) => n + a.faults.length, 0);
const brandCount = new Set(APPLIANCES.flatMap((a) => a.brands)).size;

const hasRequisites = Boolean(BRAND.inn);

const schema = [
  breadcrumbs([{ name: 'Главная', url: absoluteUrl('/', CITY) }, { name: 'О компании' }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="О сервисе"
    h1={h1}
    lead={copy.intro}
    crumbs={[{ name: 'О компании' }]}
    facts={[
      {
        value: String(APPLIANCES.length),
        label: `${plural(APPLIANCES.length, ['вид', 'вида', 'видов'])} техники`,
      },
      {
        value: String(brandCount),
        label: `${plural(brandCount, ['марка', 'марки', 'марок'])} в работе`,
      },
      {
        value: String(faultCount),
        label: plural(faultCount, ['неисправность', 'неисправности', 'неисправностей']),
      },
      { value: `${WARRANTY.workMonths} мес.`, label: 'гарантия' },
    ]}
  >
    <Fragment slot="actions">
      <a class="btn btn--primary btn--lg" href="#zayavka">Вызвать мастера</a>
      <a class="btn btn--soft btn--lg" href="/kontakty/">Контакты</a>
    </Fragment>
  </PageHero>

  <AboutService eyebrow="Подход" figures={false} />

  <Benefits sunken />

  <Steps />

  <ServiceGrid heading="Что мы ремонтируем" eyebrow="Услуги" sunken />

  <BrandStrip linked={false} dense />

  <Districts sunken />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Документы</p>
        <h2>Реквизиты и гарантия</h2>
      </div>

      <div class="docs">
        <section class="plate">
          <p class="plate__head">
            <span class="plate__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 3.5h7.5L19 9v11.5H6Z" />
                <path d="M13.5 3.5V9H19" />
                <path d="M9 13h6M9 16.5h4" />
              </svg>
            </span>
            Реквизиты
          </p>
          {
            hasRequisites ? (
              <dl class="req">
                {BRAND.legalName && <div><dt>Наименование</dt><dd>{BRAND.legalName}</dd></div>}
                <div><dt>ИНН</dt><dd>{BRAND.inn}</dd></div>
                {BRAND.ogrn && <div><dt>ОГРНИП</dt><dd>{BRAND.ogrn}</dd></div>}
                <div><dt>E-mail</dt><dd>{BRAND.email}</dd></div>
              </dl>
            ) : (
              <p class="plate__text">
                Реквизиты будут опубликованы здесь после завершения регистрации.
                Договор и закрывающие документы предоставляем по запросу — в том
                числе организациям, которым нужен безналичный расчёт.
              </p>
            )
          }
        </section>

        <section class="plate">
          <p class="plate__head">
            <span class="plate__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3.2 4.8 6v5.5c0 4.4 3 8 7.2 9.3 4.2-1.3 7.2-4.9 7.2-9.3V6Z" />
                <path d="m9 12 2.2 2.2L15.4 10" />
              </svg>
            </span>
            Что остаётся у вас
          </p>

          <ul class="plate__list">
            <li>Кассовый чек на оплаченную сумму</li>
            <li>Гарантийный талон с датой и перечнем работ</li>
            <li>Срок гарантии по каждой позиции отдельно</li>
          </ul>
          <p class="plate__text small">
            Подробные условия — на странице{' '}<a href="/garantiya/">о гарантии</a>.
          </p>
        </section>
      </div>
    </div>
  </section>

  <LeadForm />
</BaseLayout>

<style>

  .plate__list {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
  }

  .plate__list li {
    position: relative;
    padding-left: var(--sp-6);
  }

  .plate__list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 9px;
    height: 5px;
    border-left: 2px solid var(--accent-text);
    border-bottom: 2px solid var(--accent-text);
    transform: rotate(-45deg);
  }

  .docs {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: stretch;
  }

  .docs > .plate {
    display: grid;
    align-content: start;
    gap: var(--sp-5);
  }

  .req {
    display: grid;
    margin: var(--sp-4) 0 0;
  }

  .req > div {
    display: grid;
    grid-template-columns: minmax(140px, 1fr) 2fr;
    gap: var(--sp-4);
    padding-block: var(--sp-4);
  }

  .req > div + div {
    border-top: 1px solid var(--line);
  }

  .req dt {
    font-size: var(--fs-sm);
    color: var(--text-faint);
  }

  .req dd {
    margin: 0;
    color: var(--text-strong);
  }

  @media (max-width: 560px) {
    .req > div {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
