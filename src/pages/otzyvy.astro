---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/images/hero-otzyvy.png';
import Reviews from '@/components/Reviews.astro';
import Benefits from '@/components/Benefits.astro';
import LeadForm from '@/components/LeadForm.astro';
import YandexReviews from '@/components/YandexReviews.astro';

import { CITY } from '@/lib/city';
import { BRAND, CARD_CITY, LISTINGS, YANDEX_CARD } from '@/config/site';
import { telHref } from '@/lib/format';
import { absoluteUrl, buildTitle } from '@/lib/seo';
import { breadcrumbs, localBusiness } from '@/lib/schema';

const listings = LISTINGS[CITY.slug] ?? [];
const card = YANDEX_CARD[CITY.slug];

const ownCard = CITY.slug === CARD_CITY;
const phone = CITY.phoneCity || CITY.phoneMobile;

const h1 = `Отзывы о ремонте техники ${CITY.inPrep}`;

const title = buildTitle(`Отзывы о ремонте бытовой техники ${CITY.inPrep}`);
const description = `Отзывы о ремонте бытовой техники ${BRAND.name} ${CITY.inPrep} — отзывы клиентов с карточки сервиса в Яндекс Бизнесе, без правок и отбора.`;

const schema = [
  localBusiness(CITY),
  breadcrumbs([{ name: 'Главная', url: absoluteUrl('/', CITY) }, { name: 'Отзывы' }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="Отзывы"
    h1={h1}
    lead={
      ownCard
        ? 'Ниже — виджет с карточки сервиса в Яндекс Бизнесе. Это отзывы из первоисточника: мы их не отбираем, не редактируем и не можем удалить.'
        : `Карточка у сервиса одна на все города и заведена в Белгороде — отзывы ниже оттуда. Мы их не отбираем, не редактируем и не можем удалить; отзыв из ${CITY.genitive} попадёт в ту же карточку.`
    }
    crumbs={[{ name: 'Отзывы' }]}
    photo={heroPhoto}
    mediaAlt="Смартфон с оценкой в пять звёзд на экране"
  >
    <Fragment slot="actions">
      <a class="btn btn--primary btn--lg" href="#zayavka">Вызвать мастера</a>
      <a class="btn btn--soft btn--lg" href={card.url} rel="nofollow noopener" target="_blank">
        Карточка в Яндексе
      </a>
    </Fragment>
  </PageHero>

  <Reviews limit={30} heading="Что пишут клиенты" />

  <section class="section section--sunken">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Первоисточник</p>
        <h2>Что пишут клиенты</h2>
      </div>

      <div class="src">
        <YandexReviews />

        <div class="how">
          <section class="how__card">
            <span class="how__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3.6l2.5 5.1 5.6.8-4 4 .9 5.6-5-2.7-5 2.7.9-5.6-4-4 5.6-.8Z" />
              </svg>
            </span>
            <h3 class="how__title">Как оставить отзыв</h3>
            <p class="how__text">
              Если мы у вас были — расскажите, как всё прошло. Отзыв на Яндекс Картах
              помогает другим жителям {CITY.genitive} выбрать сервис осознанно, а нам
              показывает, где мы недорабатываем.
            </p>
            {listings.length > 0 ? (
              <a
                class="btn btn--primary how__btn"
                href={listings[0]}
                rel="nofollow noopener"
                target="_blank"
              >
                Оставить отзыв на Яндекс Картах
              </a>
            ) : (
              <p class="how__text muted">
                Ссылки на карточки организации появятся здесь после регистрации
                сервиса в Яндекс Бизнесе и 2ГИС.
              </p>
            )}
          </section>

          <section class="how__card">
            <span class="how__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3.2 4.8 6v5.5c0 4.4 3 8 7.2 9.3 4.2-1.3 7.2-4.9 7.2-9.3V6Z" />
                <path d="M12 9v3.6M12 15.6h.01" />
              </svg>
            </span>
            <h3 class="how__title">Если что-то пошло не так</h3>
            <p class="how__text">
              Позвоните напрямую и опишите ситуацию. Мы не спорим с клиентами: если
              ошибка наша — переделываем за свой счёт. Негативный отзыв не удаляем
              и не прячем, а отвечаем на него публично и по существу. Сервис,
              у которого одни пятёрки, выглядит подозрительно — и обычно не зря.
            </p>
            <p class="how__phone">
              <a href={telHref(phone)} data-goal="phone-reviews">{phone}</a>
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>

  <Benefits heading="На что мы даём слово" eyebrow="Обязательства" />

  <LeadForm />
</BaseLayout>

<style>
  .src {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .src {
      align-items: stretch;
    }
  }

  .how {
    display: grid;
    gap: var(--sp-4);
    align-content: stretch;
  }

  @media (min-width: 1000px) {
    .how {
      grid-auto-rows: 1fr;
      height: 100%;
    }

    .how__card {
      display: grid;
      align-content: start;
    }
  }

  .how__card {
    padding: var(--sp-6);
    background: var(--bg-raised);
    border-radius: var(--r-xl);
  }

  .how__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: var(--sp-4);
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .how__icon svg {
    width: 21px;
    height: 21px;
  }

  .how__title {
    font-size: var(--fs-lg);
  }

  .how__text {
    margin-top: var(--sp-3);
    color: var(--text-muted);
  }

  .how__btn {
    margin-top: var(--sp-5);
  }

  .how__phone {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: var(--ls-heading);
    font-variant-numeric: tabular-nums;
  }

  .how__phone a {
    color: var(--text-strong);
    text-decoration: none;
  }

  .how__phone a:hover {
    color: var(--accent-text);
  }

  @media (min-width: 1000px) {
    .src {
      grid-template-columns: 560px minmax(0, 1fr);
      gap: var(--sp-9);
    }
  }

</style>
