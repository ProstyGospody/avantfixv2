---
import ApplianceIcon from '@/components/ApplianceIcon.astro';
import ApplianceImage from '@/components/ApplianceImage.astro';
import { APPLIANCES, faultShort } from '@/data/appliances';
import { CITY } from '@/lib/city';
import { localPriceOf } from '@/lib/pricing';
import { duration, price, telHref } from '@/lib/format';
import { WARRANTY } from '@/config/site';

interface Props {
  preselect?: string;

  preselectFault?: string;
  sunken?: boolean;
}

const { preselect, preselectFault, sunken = false } = Astro.props;

const phone = CITY.phoneCity || CITY.phoneMobile;

const initial =
  preselect && APPLIANCES.some((a) => a.slug === preselect) ? preselect : APPLIANCES[0].slug;

const initialAppliance = APPLIANCES.find((a) => a.slug === initial)!;
const initialFault = preselectFault
  ? initialAppliance.faults.find((f) => f.slug === preselectFault)
  : undefined;

const ready = initialFault
  ? {
      price: `от ${price(localPriceOf(initialFault.priceFrom, CITY))}`,
      time: duration(initialFault.durationMin),
      href: `/${initialAppliance.slug}/${initialFault.slug}/`,
      subject: `${initialAppliance.short}: ${faultShort(initialFault, initialAppliance)}`,
    }
  : null;
---

<section class:list={['section', sunken && 'section--sunken']} aria-labelledby="calc-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Подбор стоимости</p>
      <h2 id="calc-heading">Узнайте цену по симптому</h2>
      <p>
        Выберите технику и то, что с ней происходит, — покажем стоимость работы
        и срок. Точную сумму мастер назовёт после диагностики и до начала ремонта.
      </p>
    </div>

    <div class="calc" data-calc>
      <div class="calc__steps">
        <div class="calc__step">
          <p class="calc__label">
            <span class="calc__num" aria-hidden="true">1</span>
            Что за техника
          </p>
          <div class="chips" role="radiogroup" aria-label="Вид техники">
            {APPLIANCES.map((a) => (
              <button
                type="button"
                class="chip"
                role="radio"
                aria-checked={a.slug === initial ? 'true' : 'false'}
                data-appliance={a.slug}
              >
                <ApplianceIcon slug={a.slug} size={19} />
                <span>{a.short}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="calc__step">
          <p class="calc__label">
            <span class="calc__num" aria-hidden="true">2</span>
            Что происходит
          </p>
          {APPLIANCES.map((a) => (
            <div
              class="chips"
              role="radiogroup"
              aria-label={`Симптом: ${a.short.toLowerCase()}`}
              data-faults={a.slug}
              hidden={a.slug !== initial}
            >
              {a.faults.map((f) => (
                <button
                  type="button"
                  class="chip"
                  role="radio"
                  aria-checked={a.slug === initial && f.slug === preselectFault ? 'true' : 'false'}
                  data-fault
                  data-price={`от ${price(localPriceOf(f.priceFrom, CITY))}`}
                  data-time={duration(f.durationMin)}
                  data-href={`/${a.slug}/${f.slug}/`}
                  data-subject={`${a.short}: ${faultShort(f, a)}`}
                >
                  {faultShort(f, a)}
                </button>
              ))}
            </div>
          ))}
        </div>

        <p class="calc__help">
          <span class="calc__help-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.6 3.4 8.2 7 6.5 8.5a9.5 9.5 0 0 0 5 5L13 11.8l3.6 1.6v3a1.6 1.6 0 0 1-1.8 1.6C8.7 17.3 3.7 12.3 3 6.2a1.6 1.6 0 0 1 1.6-1.8h2Z" />
            </svg>
          </span>
          <span class="calc__help-text">
            Не нашли свою поломку или не понимаете, что происходит с техникой?
            Опишите её по телефону — подскажем и назовём цену.
          </span>
          <span class="calc__help-call">
            <a class="calc__help-tel" href={telHref(phone)} data-goal="phone-calc">{phone}</a>
            <span class="calc__help-when">
              {CITY.workHours.days}, {CITY.workHours.open}–{CITY.workHours.close}
            </span>
          </span>
        </p>
      </div>

      <aside class="sum" data-result data-state={ready ? 'ready' : 'empty'}>

        <div class="sum__media">
          {APPLIANCES.map((a) => (
            <div data-media={a.slug} hidden={a.slug !== initial}>
              <ApplianceImage slug={a.slug} alt={a.short} sizes="160px" widths={[160, 320]} />
            </div>
          ))}
        </div>

        <p class="sum__label">Работа мастера</p>
        <p class="sum__price" data-price-out>{ready ? ready.price : '—'}</p>

        <dl class="sum__meta">
          <div>
            <dt>Срок</dt>
            <dd data-time-out>{ready ? ready.time : '—'}</dd>
          </div>
          <div>
            <dt>Гарантия</dt>
            <dd>до {WARRANTY.workMonths} мес.</dd>
          </div>
        </dl>

        <a
          class="btn btn--primary sum__cta"
          href="#zayavka"
          data-goal="calc-lead"
          data-cta
          data-subject={ready ? ready.subject : undefined}
        >
          Вызвать мастера
        </a>

        <a
          class="link-arrow sum__more"
          data-more
          href={ready ? ready.href : undefined}
          aria-disabled={ready ? undefined : 'true'}
          tabindex={ready ? undefined : -1}
        >
          Подробнее о поломке
        </a>

      </aside>
    </div>
  </div>
</section>

<style>

  .calc {
    --chip-bg: var(--bg-raised);
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-4);
    background: var(--calc-bg, var(--bg-sunken));
    border-radius: var(--r-xl);
  }

  .section--sunken .calc {
    --calc-bg: var(--bg-raised);
    --chip-bg: var(--bg-sunken);
  }

  @media (min-width: 900px) {
    .calc {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 300px);
      gap: var(--sp-5);
      padding: var(--sp-5);

      align-items: start;
    }
  }

  .calc__steps {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .calc__step {
    min-width: 0;
  }

  .calc__help {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--sp-3) var(--sp-4);
    margin: 0;
    padding: var(--sp-4);
    background: var(--chip-bg);
    border-radius: var(--r-lg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .calc__help-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .calc__help-icon svg {
    width: 20px;
    height: 20px;
  }

  .calc__help-text {
    max-width: 62ch;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--text-faint);
  }

  .calc__help-call {
    display: grid;
    gap: 2px;
    grid-column: 1 / -1;
  }

  .calc__help-tel {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    letter-spacing: var(--ls-heading);
    color: var(--text-strong);
    text-decoration: none;
    white-space: nowrap;
  }

  .calc__help-tel:hover {
    color: var(--accent-text);
  }

  .calc__help-when {
    font-size: var(--fs-sm);
    color: var(--text-faint);
  }

  @media (min-width: 560px) {
    .calc__help {
      grid-template-columns: auto 1fr auto;
    }

    .calc__help-call {
      grid-column: auto;
      justify-items: end;
      text-align: right;
    }
  }

  @media (min-width: 900px) {
    .calc__steps {
      align-self: stretch;
    }

    .calc__help {
      margin-top: auto;
    }
  }

  .calc__label {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .calc__num {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent-soft);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--accent-text);
  }

  .chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: var(--sp-2);
    align-content: start;
  }

  .chips[hidden] {
    display: none;
  }

  @media (max-width: 560px) {
    .chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 359px) {
    .chips {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .chip {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: var(--sp-2) var(--sp-3);
    background: var(--chip-bg, var(--bg-sunken));
    border: none;
    border-radius: var(--r);

    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-family: var(--font-text);
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--text);
    text-align: left;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .chip :global(svg) {
    flex: none;
  }

  .chip span {
    min-width: 0;
  }

  @media (max-width: 560px) {
    .chip :global(svg) {
      display: none;
    }

    .chip {
      gap: 0;
      padding-inline: var(--sp-3);
      font-size: var(--fs-sm);
    }

    .chip span {
      hyphens: auto;
    }
  }

  .chip:hover {
    background: color-mix(in srgb, var(--text-strong) 9%, transparent);
    color: var(--text-strong);
  }

  .chip[aria-checked='true'] {
    background: var(--accent);
    box-shadow: none;
    color: var(--on-accent);
  }

  .chip[aria-checked='true']:hover {
    background: var(--accent-hover);
    color: var(--on-accent);
  }

  .sum {
    display: grid;
    align-content: start;
    padding: var(--sp-5);
    background: var(--sum-bg, var(--bg-raised));
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-2);
  }

  .section--sunken .sum {
    --sum-bg: var(--bg-sunken);
    box-shadow: none;
  }

  @media (min-width: 900px) {
    .sum {
      position: sticky;
      top: calc(var(--header-h) + var(--sp-5));
    }
  }

  .sum__media {
    justify-self: center;
    width: 96px;
    height: 96px;
  }

  .sum__media > div {
    width: 100%;
    height: 100%;
  }

  .sum__media > div[hidden] {
    display: none;
  }

  .sum__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sum__label {
    margin-top: var(--sp-4);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .sum__price {
    margin-top: var(--sp-2);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: var(--ls-display);
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  .sum__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
    margin: var(--sp-4) 0 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .sum__meta dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .sum__meta dd {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 700;
    color: var(--text-strong);
  }

  .sum__cta {
    width: 100%;
    margin-top: var(--sp-4);
  }

  .sum__more {
    justify-self: center;
    margin-top: var(--sp-3);
    white-space: nowrap;
  }

  .sum[data-state='empty'] .sum__price {
    color: var(--text-faint);
  }

  .sum[data-state='empty'] .sum__meta dd[data-time-out] {
    color: var(--text-faint);
  }

  .sum[data-state='empty'] .sum__more {
    opacity: 0.35;
    pointer-events: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const resultBox = root.querySelector<HTMLElement>('[data-result]');
    const priceOut = root.querySelector<HTMLElement>('[data-price-out]');
    const timeOut = root.querySelector<HTMLElement>('[data-time-out]');
    const moreEl = root.querySelector<HTMLAnchorElement>('[data-more]');
    const ctaEl = root.querySelector<HTMLAnchorElement>('[data-cta]');
    if (!resultBox || !priceOut || !timeOut || !moreEl || !ctaEl) return;

    function showAppliance(slug: string) {
      root.querySelectorAll<HTMLElement>('[data-media]').forEach((m) => {
        m.hidden = m.dataset.media !== slug;
      });
      root.querySelectorAll<HTMLElement>('[data-faults]').forEach((group) => {
        group.hidden = group.dataset.faults !== slug;

        group
          .querySelectorAll('[data-fault]')
          .forEach((b) => b.setAttribute('aria-checked', 'false'));
      });
      resultBox!.dataset.state = 'empty';
      priceOut!.textContent = '—';
      timeOut!.textContent = 'выберите симптом';
      moreEl!.removeAttribute('href');
      moreEl!.setAttribute('aria-disabled', 'true');
      moreEl!.tabIndex = -1;
    }

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button.chip');
      if (!btn) return;

      if (btn.dataset.appliance) {
        root
          .querySelectorAll('[data-appliance]')
          .forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
        showAppliance(btn.dataset.appliance);
        return;
      }

      if (btn.hasAttribute('data-fault')) {
        btn
          .closest('[data-faults]')!
          .querySelectorAll('[data-fault]')
          .forEach((b) => b.setAttribute('aria-checked', String(b === btn)));

        priceOut!.textContent = btn.dataset.price ?? '';
        timeOut!.textContent = btn.dataset.time ?? '';
        moreEl!.href = btn.dataset.href ?? '#';
        moreEl!.removeAttribute('aria-disabled');
        moreEl!.removeAttribute('tabindex');
        ctaEl!.dataset.subject = btn.dataset.subject ?? '';
        resultBox!.dataset.state = 'ready';
      }
    });

    ctaEl.addEventListener('click', () => {
      const subject = ctaEl.dataset.subject;
      if (!subject) return;
      document
        .querySelectorAll<HTMLInputElement>('.lead-form input[name="subject"]')
        .forEach((input) => {
          input.value = subject;
        });
    });
  });
</script>
