---
import ApplianceImage from '@/components/ApplianceImage.astro';
import { APPLIANCES, faultShort } from '@/data/appliances';
import { CITY } from '@/lib/city';
import { minWorkPrice } from '@/lib/pricing';
import { price, typo } from '@/lib/format';

interface Props {
  heading?: string;
  intro?: string;
  eyebrow?: string;

  exclude?: string;
  sunken?: boolean;
}

const {
  heading = 'Какую технику ремонтируем',
  intro,
  eyebrow = 'Услуги',
  exclude,
  sunken = false,
} = Astro.props;

const items = APPLIANCES.filter((a) => a.slug !== exclude);
---

<section class:list={['section', sunken && 'section--sunken']} aria-labelledby="services-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="services-heading">{typo(heading)}</h2>
      {intro && <p>{intro}</p>}
    </div>

    <ul class="svc reveal">
      {
        items.map((a) => (
          <li>
            <a href={`/${a.slug}/`} class="card">

              <span class="card__stage">
                <ApplianceImage
                  slug={a.slug}
                  alt={`Ремонт ${a.genitivePlural} ${CITY.inPrep}`}
                  widths={[240, 400, 560]}
                  sizes="(max-width: 560px) 42vw, (max-width: 899px) 44vw, 30vw"
                />
              </span>

              <span class="card__body">
                <span class="card__head">
                  <span class="card__title">{a.short}</span>
                  <span class="card__arrow" aria-hidden="true">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 10h11M11 6l4 4-4 4" />
                    </svg>
                  </span>
                </span>

                <span class="card__faults">
                  {a.faults.slice(0, 3).map((f) => faultShort(f, a).toLowerCase()).join(' · ')}
                </span>

                <span class="card__price">от {price(minWorkPrice(a, CITY))}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>

  .svc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1000px) {
    .svc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .svc > li {
    min-width: 0;
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    background: var(--bg-raised);
    border-radius: var(--r-xl);
    box-shadow: inset 0 0 0 1px var(--line);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      box-shadow 0.22s var(--ease),
      transform 0.22s var(--ease-out);
  }

  .card:hover {
    box-shadow:
      inset 0 0 0 1px transparent,
      var(--shadow-3);
    transform: translateY(-3px);
    text-decoration: none;
  }

  .card__stage {
    display: grid;
    align-content: end;
    height: 210px;

    padding: var(--sp-4) var(--sp-5) 0;
    background:
      radial-gradient(70% 70% at 50% 100%, var(--bg-raised) 0%, transparent 72%),
      var(--bg-sunken);
    transition: background-color 0.22s var(--ease);
  }

  .section--sunken .card__stage {
    background:
      radial-gradient(70% 70% at 50% 100%, var(--bg-raised) 0%, transparent 72%),
      color-mix(in srgb, var(--text-strong) 5%, transparent);
  }

  .card:hover .card__stage {
    background:
      radial-gradient(70% 70% at 50% 100%, var(--bg-raised) 0%, transparent 72%),
      var(--accent-soft);
  }

  .card__stage :global(.cutout-img) {
    object-position: bottom;
  }

  .card:hover .card__stage :global(.cutout-img) {
    transform: translateY(-4px);
  }

  .card__stage :global(.cutout-img) {
    transition: transform 0.35s var(--ease-out);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-5);
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }

  .card__faults {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--text-faint);
  }

  .card__price {
    margin-top: auto;
    padding-top: var(--sp-2);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    letter-spacing: var(--ls-heading);
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .card__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--bg-sunken);
    color: var(--accent-text);
    transition:
      transform 0.16s var(--ease-out),
      background-color 0.16s var(--ease);
  }

  .card__arrow svg {
    width: 16px;
    height: 16px;
  }

  .card:hover .card__arrow {
    background: var(--accent);
    color: var(--on-accent);
    transform: translateX(2px);
  }

  @media (max-width: 899px) {
    .card__stage {
      height: 190px;
    }
  }

  @media (max-width: 560px) {
    .svc {
      gap: var(--sp-3);
    }

    .card__stage {
      height: 150px;
      padding: var(--sp-3) var(--sp-4) 0;
    }

    .card__title {
      font-size: var(--fs-base);
      letter-spacing: -0.01em;
    }

    .card__faults {
      display: none;
    }

    .card__body {
      padding: var(--sp-4);
    }

    .card__arrow {
      display: none;
    }
  }
</style>
