---
import { CITY } from '@/lib/city';
import { typo } from '@/lib/format';
import { BENEFITS_COPY } from '@/data/copy';

interface Props {
  heading?: string;
  eyebrow?: string;
  sunken?: boolean;
}

const {
  heading = 'Как мы работаем с деньгами и доверием',
  eyebrow = 'Обязательства',
  sunken = false,
} = Astro.props;

const items = BENEFITS_COPY[CITY.slug];
---

<section class:list={['section', sunken && 'section--sunken']} aria-labelledby="benefits-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="benefits-heading">{typo(heading)}</h2>
    </div>

    <ul class="ben reveal">
      {
        items.map((item) => (
          <li class="ben__item">
            <span class="ben__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                {item.icon === 'tag' && (
                  <>
                    <path d="M3.5 11.2V4.6a1 1 0 0 1 1-1h6.6a1 1 0 0 1 .7.3l8.3 8.3a1 1 0 0 1 0 1.4l-6.6 6.6a1 1 0 0 1-1.4 0L3.8 11.9a1 1 0 0 1-.3-.7Z" />
                    <circle cx="8" cy="8" r="1.4" />
                  </>
                )}
                {item.icon === 'shield' && (
                  <>
                    <path d="M12 3.2 4.8 6v5.5c0 4.4 3 8 7.2 9.3 4.2-1.3 7.2-4.9 7.2-9.3V6Z" />
                    <path d="m9 12 2.2 2.2L15.4 10" />
                  </>
                )}
                {item.icon === 'eye' && (
                  <>
                    <path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z" />
                    <circle cx="12" cy="12" r="2.8" />
                  </>
                )}
                {item.icon === 'wallet' && (
                  <>
                    <path d="M3.5 7.4A1.9 1.9 0 0 1 5.4 5.5h11.7a1.9 1.9 0 0 1 1.9 1.9v1.4" />
                    <rect x="3.5" y="7.4" width="17" height="11.1" rx="2.2" />
                    <circle cx="16.4" cy="13" r="1.2" />
                  </>
                )}
                {item.icon === 'doc' && (
                  <>
                    <path d="M14 3.2H7a1.8 1.8 0 0 0-1.8 1.8v14a1.8 1.8 0 0 0 1.8 1.8h10a1.8 1.8 0 0 0 1.8-1.8V8Z" />
                    <path d="M14 3.2V8h4.8" />
                    <path d="M8.6 13.6h6.8M8.6 17h4.4" />
                  </>
                )}
                {item.icon === 'clock' && (
                  <>
                    <circle cx="12" cy="12" r="8.6" />
                    <path d="M12 7.2V12l3.2 1.9" />
                  </>
                )}
              </svg>
            </span>
            <h3 class="ben__title">{item.title}</h3>
            <p class="ben__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>

  .ben {
    display: grid;
    gap: var(--sp-7) var(--sp-6);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  @media (min-width: 900px) {
    .ben {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ben__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-1) var(--sp-4);
  }

  .ben__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .ben__icon svg {
    width: 21px;
    height: 21px;
  }

  .ben__title {
    font-size: var(--fs-lg);
  }

  .ben__text {
    grid-column: 2;
    margin-top: var(--sp-3);
    font-size: var(--fs-base);
    line-height: var(--lh-snug);
    color: var(--text-muted);
    max-width: 40ch;
  }

  @media (max-width: 560px) {
    .ben__text {
      grid-column: 1 / -1;
    }
  }
</style>
