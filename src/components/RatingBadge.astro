---
import { BRAND, YANDEX_CARD } from '@/config/site';
import { CITY } from '@/lib/city';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const card = YANDEX_CARD[CITY.slug];
---

{
  card?.orgId && (
    <iframe
      class:list={['rate', className]}
      src={`https://yandex.ru/sprav/widget/rating-badge/${card.orgId}?type=rating`}
      width="150"
      height="50"
      loading="lazy"
      title={`Оценка ${BRAND.name} на Яндекс Картах`}
    />
  )
}

<style>

  .rate {
    display: block;
    flex: none;
    border: 0;
    color-scheme: light;
  }

  .rate {
    align-self: center;
  }
</style>
