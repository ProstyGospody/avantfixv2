---
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;

  widths?: number[];
  sizes?: string;

  eager?: boolean;

  quality?: number;
  class?: string;
}

const {
  src,
  alt,
  widths = [180, 320, 480],
  sizes = '(max-width: 560px) 40vw, 200px',
  eager = false,
  quality = 68,
  class: className,
} = Astro.props;
---

{
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={quality}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
    class:list={['cutout-img', className]}
    pictureAttributes={{ class: 'cutout-pic' }}
  />
}

<style>

  :global(.cutout-pic) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  :global(.cutout-img) {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
  }
</style>
